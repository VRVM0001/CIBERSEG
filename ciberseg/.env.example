# Copia este archivo como ".env" y ajusta los valores a tu computadora.

# Clave secreta de Flask (sesiones). Pon cualquier texto largo y aleatorio.
SECRET_KEY=cambia-esta-clave

# --- SQL Server ---
# El "Server name" que usas al conectarte en SSMS. Ejemplos comunes:
#   localhost\SQLEXPRESS      (instalacion tipica de SQL Server Express)
#   localhost                 (instalacion por defecto sin instancia)
#   TU-PC\SQLEXPRESS          (nombre de tu computadora + instancia)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=ciberseg

# Autenticacion: windows = Windows Authentication (recomendada, sin clave)
#                sql     = usuario y clave de SQL Server
DB_AUTH=windows
DB_USER=
DB_PASSWORD=

# Driver ODBC instalado en tu PC (ver en "Origenes de datos ODBC" de Windows)
DB_DRIVER=ODBC Driver 17 for SQL Server
